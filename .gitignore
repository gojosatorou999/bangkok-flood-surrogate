# Only things that are rebuilt automatically or are machine specific. Everything else is in the repo on purpose
# (camera photos, CCTV frames, observation database, ANUGA result arrays through Git LFS), so a new laptop gets it all.
__pycache__/
*.pyc
.venv/
*.tmp
# downloaded NOAA subsets and the published forecast bundle: re-created by the app
cache/gfs/
cache/bundle/
cache/bundle.tmp/
cache/bundle.old/
# output of deploy/build_frontend.py
frontend/
# credentials must never be committed (none exist today)
.env
secrets/
