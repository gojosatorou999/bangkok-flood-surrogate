# shell scripts and unit files must keep LF endings (they run on Linux)
*.sh text eol=lf
*.service text eol=lf
*.timer text eol=lf
Caddyfile text eol=lf
cache/*_depth.npy filter=lfs diff=lfs merge=lfs -text
cache/*_speed.npy filter=lfs diff=lfs merge=lfs -text
# other cities' ANUGA arrays (cache/hatyai/, ...)
cache/*/*_depth.npy filter=lfs diff=lfs merge=lfs -text
cache/*/*_speed.npy filter=lfs diff=lfs merge=lfs -text
