{
  "buildCommand": "python3 deploy/build_frontend.py",
  "outputDirectory": "frontend",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/dashboard", "destination": "/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://YOUR-API-HOST/api/:path*" }
  ],
  "headers": [
    { "source": "/static/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=86400" } ] }
  ]
}
